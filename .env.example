# Необязательная AI-аналитика. Без ключа работает локальный аналитический разбор.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
PORT=3001
COOKIE_SECURE=false
# Для HTTPS-развёртывания установите COOKIE_SECURE=true.
# DATABASE_PATH можно задать для отдельного SQLite-файла; по умолчанию data/astana-simulator.sqlite.
